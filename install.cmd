/* ===== RESET & BASE ===== */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  background: #0a0a0a;
  overflow: hidden;
  font-family: monospace;
}

/* ===== APPLE II FRAME =====
   Image anchored at top-left, height fills viewport.
   All overlays use % relative to this frame = image pixel coords.
   Image is 1536x1024, so displayed width = 100vh * 1.5              */

/* CRT glass edges measured from 1536x1024 source image.
   Image renders at height=100vh, width=150vh (1.5:1 aspect).
   left:   178/1536 * 150vh = 17.4vh     top:   78/1024 * 100vh =  7.6vh
   width:  534/1536 * 150vh = 52.1vh     height: 382/1024 * 100vh = 37.3vh */

#apple2-frame {
  position: relative;
  width: 150vh;
  height: 100vh;
}

#bg-image {
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
  user-select: none;
}

/* ===== SCREEN OVERLAY (over the CRT glass) =====
   Position is set by JS (positionScreen in main.js) based on
   actual rendered image dimensions. CSS values are fallbacks. */
#screen-container {
  position: absolute;
  left: 0; top: 0; width: 0; height: 0; /* JS overrides these */
  background: transparent;
  border-radius: 4px;
  overflow: hidden;
  z-index: 2;
}

#screen {
  position: absolute;
  top: 4%;
  left: 1%;
  right: 1%;
  bottom: 4%;
  z-index: 1;
}

/* ===== MAIN CANVAS (text + graphics — everything) ===== */
#apple2-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: #000;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

/* ===== HIDDEN FILE UPLOAD ===== */
#file-upload {
  display: none;
}

/* ===== POWER BUTTON =====
   Positioned on the Apple II case, left side above keyboard.
   Image coords: ~170px left, ~595px top → 11.1%, 58.1%             */
#power-btn {
  position: absolute;
  left: 11%;
  top: 58%;
  width: 28px;
  height: 28px;
  background: rgba(40, 40, 35, 0.8);
  border: 2px solid #666;
  border-radius: 50%;
  cursor: pointer;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  user-select: none;
  box-shadow: 0 1px 4px rgba(0,0,0,0.5);
}

#power-btn:hover {
  border-color: #999;
  background: rgba(60, 60, 55, 0.9);
  box-shadow: 0 1px 8px rgba(0,0,0,0.7);
}

#power-btn:active {
  background: rgba(25, 25, 22, 0.9);
  transform: scale(0.93);
}

#power-led {
  width: 10px;
  height: 10px;
  background: #333;
  border-radius: 50%;
  box-shadow: none;
  transition: background 0.3s, box-shadow 0.3s;
}

#power-led.on {
  background: #4f4;
  box-shadow: 0 0 8px #4f4, 0 0 16px rgba(68, 255, 68, 0.4);
  animation: led-glow 2s ease-in-out infinite alternate;
}

@keyframes led-glow {
  0% { box-shadow: 0 0 6px #4f4; }
  100% { box-shadow: 0 0 12px #4f4, 0 0 24px rgba(68, 255, 68, 0.3); }
}

/* ===== DISK II DRIVE LEDs ===== */
.drive-led {
  position: absolute;
  border-radius: 50%;
  background: rgba(60, 40, 10, 0.6);
  border: none;
  z-index: 20;
  pointer-events: none;
  transition: background 0.1s, box-shadow 0.1s;
}

.drive-led.active {
  background: #ffb000;
  box-shadow: 0 0 8px #ffb000, 0 0 18px rgba(255, 176, 0, 0.6), 0 0 30px rgba(255, 140, 0, 0.3);
}

/* ===== SCREEN POSITION CONTROLS (dev) ===== */
#pos-controls {
  position: fixed;
  top: 4px;
  left: 4px;
  z-index: 9999;
  display: none;
  align-items: center;
  gap: 4px;
  background: rgba(0,0,0,0.85);
  border: 1px solid #555;
  border-radius: 4px;
  padding: 3px 6px;
  white-space: nowrap;
}
#pos-controls button {
  background: #333;
  color: #0f0;
  border: 1px solid #666;
  border-radius: 3px;
  padding: 2px 7px;
  font: bold 11px monospace;
  cursor: pointer;
}
#pos-controls button:hover { background: #555; }
#pos-controls button:active { background: #0a0; color: #000; }
#pos-display {
  color: #0f0;
  font: bold 11px monospace;
  margin-right: 6px;
}
#pos-controls label {
  color: #aaa;
  font: 11px monospace;
}
#pos-controls input[type=number] {
  background: #222;
  color: #0f0;
  border: 1px solid #555;
  border-radius: 2px;
  font: 11px monospace;
  padding: 1px 3px;
}

/* ===== CRT POWER ON/OFF ===== */
#screen-container.off #apple2-canvas {
  visibility: hidden;
}

#screen-container.off {
  background: transparent;
}

#screen-container:not(.off) {
  opacity: 1;
}

#screen-container.crt-on {
  animation: crt-turn-on 0.4s ease-out;
}

@keyframes crt-turn-on {
  0% {
    filter: brightness(0);
  }
  20% {
    filter: brightness(2.5) saturate(0);
  }
  40% {
    filter: brightness(1.5);
  }
  100% {
    filter: brightness(1);
  }
}

#screen-container.crt-off {
  animation: crt-turn-off 0.35s ease-in forwards;
}

@keyframes crt-turn-off {
  0% {
    filter: brightness(1);
    transform: scale(1, 1);
  }
  50% {
    filter: brightness(2);
    transform: scale(1.02, 0.6);
  }
  70% {
    filter: brightness(3);
    transform: scale(0.8, 0.01);
  }
  90% {
    filter: brightness(1);
    transform: scale(0.4, 0.005);
  }
  100% {
    filter: brightness(0);
    transform: scale(0, 0);
  }
}
